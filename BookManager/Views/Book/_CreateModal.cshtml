@model BookManager.ViewModels.BookViewModel

<dialog id="addBookWindow">
	<h2>Добавить книгу</h2>

	<form asp-action="Create" method="post">

		<label asp-for="NewBook.Title">Название</label>
		<input asp-for="NewBook.Title"/>
		<span asp-validation-for="NewBook.Title"></span>

		<label asp-for="NewBook.Genre">Жанр</label>
		<input asp-for="NewBook.Genre"/>
		<span asp-validation-for="NewBook.Genre"></span>

		<label asp-for="NewBook.Year">Год издания</label>
		<input asp-for="NewBook.Year" />
		<span asp-validation-for="NewBook.Year"></span>

		<label asp-for="AuthorName">Имя автора</label>
		<input asp-for="AuthorName"/>
		<span asp-validation-for="AuthorName"></span>

		<div class="book-form-buttons">
			<button type="submit">Добавить</button>
			<button type="button" id="closeBookWindow">Отмена</button>
		</div>

	</form>

</dialog>

@if(!ViewData.ModelState.IsValid)
{
	<script>
		document.querySelector("#addBookWindow").showModal();
	</script>
}