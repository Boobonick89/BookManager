@model List<BookManager.Models.Book>
<link rel="stylesheet" href="~/css/book/book.css"/>

<h1>Книги</h1>
<button id="addBookButton" class="add-book-button">Добавить книгу</button>


	<table>
		<thead>
			<tr>
				<th>Название</th>
				<th>Жанр</th>
				<th>Год</th>
				<th>Автор</th>
				<th>Действия</th>
			</tr>
		</thead>

	<tbody>
		@foreach (var book in Model)
		{
			<tr>
				<td>@book.Title</td>
				<td>@book.Genre</td>
				<td>@book.Year</td>
				<td>@book.Author.Name</td>
				<td>
					<button class="edit-book-button"
					data-id="@book.Id"
					data-title="@book.Title"
					data-genre="@book.Genre"
					data-year="@book.Year"
					data-author="@book.Author.Name">
				Редактировать
				</button>
				</td>
			</tr>
		}

	</tbody>
	</table>


<partial name="_CreateModal" />
<partial name="_EditModal" />
<script src="~/js/book/book.js"></script>