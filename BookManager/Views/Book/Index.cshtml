@model BookManager.ViewModels.BookViewModel

<link rel="stylesheet" href="~/css/book/book.css" />

<h1>Книги</h1>

<div class="book-toolbar">
	<button id="addBookButton" class="add-book-button">Добавить книгу</button>
	<button id="searchBookButton" class="search-book-button">Поиск</button>

	@if (ViewBag.HasFilters)
	{
		<a asp-action="Index" class="add-book-button">Сбросить фильтры</a>
	}

</div>

	<table>
		<thead>
			<tr>
				<th>Название</th>
				<th>Жанр</th>
				<th>Год</th>
				<th>Автор</th>
				<th>Действия</th>
			</tr>
		</thead>

	<tbody>
		@foreach (var book in Model.Books)
		{
			<tr>
				<td>@book.Title</td>
				<td>@book.Genre</td>
				<td>@book.Year</td>
				<td>@book.Author?.Name</td>
				<td>
					<partial name="_BookActions" model="@book" />
				</td>
			</tr>
		}

	</tbody>
	</table>


<partial name="_CreateModal" model="Model" />
<partial name="_EditModal" />
<partial name="_SearchModal" />

@if (TempData["EditError"] != null)
{
	<dialog id="editErrorWindow" class="message-dialog" open>
		<p>@TempData["EditError"]</p>
		<button type="button" id="closeEditError" class="add-book-button">ОК</button>
	</dialog>

	<script>
		const errorWindow = document.querySelector("#editErrorWindow");
		const closeErrorButton = document.querySelector("#closeEditError");

		closeErrorButton.addEventListener("click", () => {
			errorWindow.close();
		});
	</script>
}

<script src="~/js/book/book.js"></script>